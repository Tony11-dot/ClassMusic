// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// Secrets.xcconfig is read by project.yml and injected into Info.plist,
// then read at runtime via Bundle.main.infoDictionary — see Shared/Secrets.swift.

// YouTube Data API v3 key (console.cloud.google.com -> APIs & Services -> Credentials).
// Restrict it to the YouTube Data API v3, and to your app's bundle ID / iOS.
YOUTUBE_API_KEY = REPLACE_ME

// Base URL of the deployed resolve backend, no trailing slash.
// NOTE: xcconfig treats a bare "//" as a comment, so the scheme's slashes
// are broken up with the empty build-setting reference "$()" below — that's
// not a typo, it's required for the URL to parse. Local dev value shown:
BACKEND_BASE_URL = http:/$()/localhost:8123

// Must match BACKEND_API_KEY set on the Render service (backend/render.yaml).
BACKEND_API_KEY = REPLACE_ME
